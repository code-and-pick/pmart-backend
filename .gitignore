# Gradle
.gradle/
build/
**/build/
!**/src/**/build/
.kotlin/

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# 로컬 환경 (비밀정보는 애초에 저장소에 넣지 않는다)
.env
.env.*
*.local.yml
*.local.yaml

# 테스트·리포트 산출물
out/
reports/
*.log
# RAG 검증 기록의 원본 로그는 남긴다(2026-11-16 사용자 — 빌드·시험 출력뿐, 비밀값 없음을 확인하고 넣는다)
!docs/rag/verification/**/*.log

# JVM 크래시 로그
hs_err_pid*.log
replay_pid*.log

# Claude Code 개인 설정 (권한 허용 규칙 등)
.claude/settings.local.json

# LAN 배포 비밀정보 (deploy/lan/init-secrets.sh 가 생성)
deploy/lan/.secrets/
# 다른 PC 에서 비밀번호 파일을 저장소 루트에 잘못 복사하는 경우 대비(2026-11-13 PC 3 PR #1 지적). 정본 위치는 위 deploy/lan/.secrets/
/.secrets/
# config-server 설정 저장소(GitHub code-and-pick/pmart-config) 로컬 사본 — lan.sh config-push (ADR-0027)
deploy/lan/.config-repo/

# 외부 참고 자료 원본 (저작권 문제로 저장소에 올리지 않는다: 상품·카테고리·이미지 등)
local-reference/

# OAuth 제공자 클라이언트 파일(Google client_secret_*.json 등). 원본은 deploy/lan/.secrets/google-oauth/ 에 둔다
client_secret_*.json
**/google-oauth/
# 문서 폴더에 같이 들어온 키 파일(예: docs/toss/env). 키는 deploy/lan/.secrets/ 에 둔다
/docs/**/env

# LAN 임시 백오피스 빌드 산출물(pmart-clients web/backoffice dist 사본, lan.sh publish-backoffice)
/deploy/lan/backoffice-dist/
# 인사팀 백오피스 빌드 사본(pmart-clients web/hr-backoffice dist, lan.sh publish-hr-backoffice)
/deploy/lan/hr-backoffice-dist/
/deploy/lan/mfc-backoffice-dist/
/deploy/lan/rider-backoffice-dist/
/deploy/lan/cdc-backoffice-dist/
# 검색 재색인 진행 상태(deploy/lan/elastic/reindex.sh)
deploy/lan/.reindex.state
# 배포 잠금(deploy/lan/lan.sh lan_lock — 두 세션 render·deploy 겹침 방지)
/deploy/lan/.deploy.lock/
# Python 캐시(2026-11-18 — PR #168·#186·#188 에 .pyc 가 섞여 들어옴). 이미 추적 중인 8개는 따로 뺀다(작업 세션)
__pycache__/
*.pyc
# Vault init 결과(unseal 키·root 토큰) — deploy/vault/vault.sh init. 옮긴 뒤 지운다
deploy/vault/.init/
# Vault 서버 TLS 인증서·개인키(PC 1 lan.sh tls-issue 로 발급해 서버 PC 에만 둔다)
deploy/vault/tls/
