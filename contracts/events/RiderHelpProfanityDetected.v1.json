{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/RiderHelpProfanityDetected.v1.json",
  "title": "RiderHelpProfanityDetected",
  "description": "배송 도움요청 대화(도움요청 내용·라이더 메시지·전달 재개 메모)에서 정지 단어(위협·거친 말)를 자동으로 찾은 사실 — 글·걸린 단어는 싣지 않는다. 발행 delivery-execution(2026-11-23, 사용자 \"응\" — 문의와 같은 규칙을 도움요청에도). 욕설(막기 목록)은 사건 없이 422 BLOCKED_WORDS. 구독 rider(7일 정지 — RS-8 과 같은 규칙). 글은 그대로 받는다. 토픽 delivery.delivery.v1.",
  "allOf": [
    { "$ref": "_envelope.v1.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "RiderHelpProfanityDetected" },
        "aggregateType": { "const": "Delivery" },
        "payload": {
          "type": "object",
          "required": ["riderId", "deliveryId", "requestId", "source", "detectedAt"],
          "properties": {
            "riderId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "deliveryId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "requestId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "source": { "type": "string", "enum": ["HELP_REQUEST", "HELP_MESSAGE", "RESUME_REQUEST"] },
            "detectedAt": { "$ref": "_defs.v1.json#/$defs/DateTime" }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
