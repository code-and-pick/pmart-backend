{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ShipmentReady.v1.json",
  "title": "ShipmentReady",
  "description": "출하 대기 상태가 된 사실(배차 요청 트리거). 발행 mfc-fulfillment. 구독 delivery-dispatch, delivery-execution, order. 토픽 mfc.fulfillment.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ShipmentReady"
        },
        "aggregateType": {
          "const": "Shipment"
        },
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "shipmentId",
            "mfcId",
            "readyAt",
            "packages"
          ],
          "properties": {
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "fulfillmentId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "shipmentId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "readyAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "packageId"
                ],
                "properties": {
                  "packageId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  },
                  "bagCount": {
                    "type": "integer"
                  },
                  "weightG": {
                    "type": "integer",
                    "description": "총 중량(g)"
                  },
                  "volumeCm3": {
                    "type": "integer"
                  },
                  "alcohol": {
                    "type": "boolean",
                    "description": "주류 포함 여부(성인 확인 필요)"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "orderLineId",
                        "qty"
                      ],
                      "properties": {
                        "orderLineId": {
                          "$ref": "_defs.v1.json#/$defs/Ref"
                        },
                        "sku": {
                          "$ref": "_defs.v1.json#/$defs/Sku"
                        },
                        "qty": {
                          "$ref": "_defs.v1.json#/$defs/PositiveQty"
                        }
                      }
                    }
                  }
                }
              },
              "minItems": 1
            },
            "pickupLocation": {
              "type": "string",
              "description": "MFC 내 픽업 위치 코드"
            },
            "deliveryMode": {
              "$ref": "_defs.v1.json#/$defs/DeliveryMode"
            },
            "arrivalWindow": {
              "$ref": "_defs.v1.json#/$defs/TimeWindow"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
