{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/DeliveryAssigned.v1.json",
  "title": "DeliveryAssigned",
  "description": "유효 수락 1건 확정. 발행 delivery-dispatch. 구독 delivery-execution, delivery-tracking, mfc-fulfillment, order, notification. 토픽 delivery.delivery.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "DeliveryAssigned"
        },
        "aggregateType": {
          "const": "Delivery"
        },
        "payload": {
          "type": "object",
          "required": [
            "deliveryId",
            "riderId",
            "assignmentVersion",
            "acceptedAt"
          ],
          "properties": {
            "deliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "riderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "offerId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "assignmentVersion": {
              "$ref": "_defs.v1.json#/$defs/Version"
            },
            "acceptedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "fee": {
              "$ref": "_defs.v1.json#/$defs/Money",
              "description": "수락 당시 예상 배달료(원문 §7.1 표 — 제안·수락 당시 금액 기록). execution 수행료의 기준(2026-11-13 추가)"
            },
            "vehicleType": {
              "type": "string",
              "description": "수락 당시 라이더 배달 수단"
            },
            "orderNumber": {
              "type": "string",
              "description": "화면용 주문번호(2026-11-17 — 라이더 내 배달 내역용, dispatch 의 주문 요약 사본에서. 없으면 뺀다)"
            },
            "mfcName": {
              "type": "string",
              "description": "픽업지 지점 이름(2026-11-17 — 원문 §8.1 배달현황, center-master 이름 사본. 없으면 뺀다)"
            },
            "distanceM": {
              "type": "integer",
              "minimum": 0,
              "description": "MFC → 고객 도로 거리(m) — 요금 구간 근거"
            },
            "mfcPhone": {
              "type": "string",
              "description": "픽업 지점 전화(2026-11-17 — center-master profile, 없으면 뺀다). 라이더 배송 조회용"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
