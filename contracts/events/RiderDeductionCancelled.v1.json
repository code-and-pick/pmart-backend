{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/RiderDeductionCancelled.v1.json",
  "title": "RiderDeductionCancelled",
  "description": "오배송 정산 차감 취소(2026-11-24, ADR-0086) — 지원센터가 이의를 받아들임. 발행 delivery-execution. 구독 notification(요청), BI. 토픽 delivery.delivery.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "RiderDeductionCancelled"
        },
        "aggregateType": {
          "const": "Delivery"
        },
        "payload": {
          "type": "object",
          "required": [
            "deductionId",
            "caseId",
            "deliveryId",
            "riderId",
            "amount",
            "remaining",
            "state",
            "objectionDeadline",
            "recordedAt"
          ],
          "properties": {
            "deductionId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "caseId": { "type": "string", "maxLength": 64 },
            "deliveryId": { "$ref": "_defs.v1.json#/$defs/Ref", "description": "오배송된(원래) 배송" },
            "deliveryNumber": { "type": "string", "maxLength": 32 },
            "recoveryDeliveryId": { "type": "string", "maxLength": 64 },
            "orderId": { "type": "string", "maxLength": 64 },
            "riderId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "amount": { "type": "integer", "minimum": 1 },
            "remaining": { "type": "integer", "minimum": 0 },
            "state": { "type": "string", "enum": ["PENDING_OBJECTION", "OBJECTED", "CONFIRMED", "CANCELLED"] },
            "objectionDeadline": { "$ref": "_defs.v1.json#/$defs/DateTime" },
            "source": { "type": "string", "enum": ["MISDELIVERY_RECOVERY", "MANUAL"], "description": "(2026-11-24) 회수 포기 자동 차감 · 직원 직접 차감(POST /rider-deductions)" },
            "decision": { "type": "string", "enum": ["ACCEPT", "REJECT"], "description": "이의 결정으로 바뀐 때만" },
            "recordedAt": { "$ref": "_defs.v1.json#/$defs/DateTime" }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
