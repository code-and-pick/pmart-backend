{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/DeliveryFailed.v1.json",
  "title": "DeliveryFailed",
  "description": "전달 실패·중단(자동 환불 없음). 운영자가 라이더의 실패 등록을 확정했을 때(2026-11-13 — 확정 전은 진행 중). 발행 delivery-execution. 구독 order, claim, case, notification, delivery-dispatch(배송 CLOSED — 라이더 진행 중 수에서 뺌). 토픽 delivery.delivery.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "DeliveryFailed"
        },
        "aggregateType": {
          "const": "Delivery"
        },
        "payload": {
          "type": "object",
          "required": [
            "deliveryId",
            "reason",
            "custody",
            "failedAt"
          ],
          "properties": {
            "deliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "riderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "reason": {
              "type": "string",
              "description": "실패 사유 코드"
            },
            "custody": {
              "type": "string",
              "enum": [
                "RIDER",
                "STORE"
              ]
            },
            "failedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "goodsLocation": {
              "type": "string",
              "description": "라이더가 적은 상품 위치(WITH_RIDER·RETURNED_TO_STORE·LEFT_AT_DOOR·UNKNOWN)"
            },
            "returnBy": {
              "type": "string",
              "enum": [
                "SAME_RIDER",
                "OTHER_RIDER"
              ],
              "description": "2026-11-17 — custody RIDER 일 때 MFC 반납할 사람. 없으면 SAME_RIDER. OTHER_RIDER 면 dispatch 가 근처 다른 라이더에게 회수 제안(원래 라이더 제외)"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
