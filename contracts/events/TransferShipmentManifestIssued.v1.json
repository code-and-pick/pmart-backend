{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/TransferShipmentManifestIssued.v1.json",
  "title": "TransferShipmentManifestIssued",
  "description": "출발 매니페스트가 발행된 사실. 발행 cdc-outbound. 구독 mfc-inbound, transport-execution. 토픽 cdc.outbound.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "TransferShipmentManifestIssued"
        },
        "aggregateType": {
          "const": "ShipmentManifest"
        },
        "payload": {
          "type": "object",
          "required": [
            "shipmentManifestId",
            "trfId",
            "departureId",
            "lines"
          ],
          "properties": {
            "shipmentManifestId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "trfId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "departureId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "tripId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "fromCdc": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "toMfc": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "lines": {
              "type": "array",
              "items": {
                "$ref": "_defs.v1.json#/$defs/SkuLotLpnQty"
              },
              "minItems": 1
            },
            "totalQty": {
              "$ref": "_defs.v1.json#/$defs/Qty"
            },
            "issuedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "containers": {
              "type": "array",
              "description": "(2026-11-26 CO-2) 출발한 그릇 단위(RT 롤테이너·PLT 팔레트) — 박스는 lines[].parentLpn 으로 소속",
              "items": {
                "type": "object",
                "required": [
                  "lpn",
                  "unitType"
                ],
                "properties": {
                  "lpn": {
                    "type": "string"
                  },
                  "unitType": {
                    "type": "string",
                    "enum": [
                      "PLT",
                      "RT"
                    ]
                  }
                }
              }
            },
            "labelValue": {
              "type": "string",
              "description": "(2026-11-26 CO-1) 송장 라벨 스캔 값 TRF:{trfId}:{trfVersion}"
            },
            "trfNumber": {
              "type": ["string", "null"],
              "description": "(2026-11-27 R-52, cdc-outbound 0.33.0) TRF 화면 번호 T+6"
            },
            "waveId": {
              "type": "string",
              "description": "(2026-11-27 R-52) 이 TRF 를 담은 Wave"
            },
            "waveNumber": {
              "type": ["string", "null"],
              "description": "(2026-11-27 R-52) Wave 화면 번호 W+4"
            },
            "trfVersion": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
