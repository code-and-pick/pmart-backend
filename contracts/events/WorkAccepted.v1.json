{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/WorkAccepted.v1.json",
  "title": "WorkAccepted",
  "description": "ConfirmOrder 작업을 수락한 사실(수락≠완료). 발행 mfc-fulfillment. 구독 order-orchestration(6a 는 동기 응답으로 진행 — 사건은 기록·BI용). 토픽 mfc.fulfillment.v1 2026-11-16: 오배송 재발송(작업 지시 kind RESHIPMENT)이면 purpose MISDELIVERY_RESHIPMENT·caseId.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "WorkAccepted"
        },
        "aggregateType": {
          "const": "Fulfillment"
        },
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "fulfillmentId",
            "taskIds"
          ],
          "properties": {
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "fulfillmentId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "shipmentIds": {
              "type": "array",
              "items": {
                "$ref": "_defs.v1.json#/$defs/Ref"
              }
            },
            "taskIds": {
              "type": "array",
              "items": {
                "$ref": "_defs.v1.json#/$defs/Ref"
              }
            },
            "acceptedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "workVersion": {
              "type": "integer",
              "minimum": 1,
              "description": "접수된 작업 버전(2026-11-07 추가, ConfirmOrder.workVersion)"
            },
            "sagaId": {
              "$ref": "_defs.v1.json#/$defs/Ref",
              "description": "요청한 orchestration 사가(2026-11-07 추가)"
            },
            "purpose": {
              "type": "string",
              "enum": [
                "MISDELIVERY_RESHIPMENT"
              ],
              "description": "2026-11-16 — 오배송 재발송 작업 지시의 출고면 MISDELIVERY_RESHIPMENT(없으면 일반 주문 출고)"
            },
            "caseId": {
              "$ref": "_defs.v1.json#/$defs/Ref",
              "description": "오배송 재발송의 근거 사건(case)"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
