{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/RiderPayoutEscalated.v1.json",
  "title": "RiderPayoutEscalated",
  "description": "지급 넘김 상한을 다 쓴 지급 실패(2026-11-24, ADR-0086 결정 9 — 사용자 \"3번 안에는 반드시 줘야해\", 요청 DE-10). 지급 실패 줄이 자동 넘김 상한(기본 3번)을 다 쓰고 또 실패해 더 넘기지 않을 때 묶음(라이더 × 지급 예정일)마다 한 번 — 직원이 직접 지급해야 한다. 발행 delivery-execution. 구독 미정(PC 1 — 직원 알림), BI. 토픽 delivery.delivery.v1(aggregate = 묶음의 첫 실패 줄 배송). 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "RiderPayoutEscalated"
        },
        "aggregateType": {
          "const": "Delivery"
        },
        "payload": {
          "type": "object",
          "required": ["batchId", "riderId", "payoutDate", "amount", "lineCount", "rollCount", "escalatedAt"],
          "properties": {
            "batchId": { "type": "string", "maxLength": 100, "description": "<riderId>:<payoutDate> — 지급 묶음" },
            "riderId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "payoutDate": { "type": "string", "format": "date", "description": "실패한(남은) 지급 예정일" },
            "amount": { "type": "integer", "minimum": 0, "description": "넘기지 않은 줄(수행료·보상금) 합계(원)" },
            "lineCount": { "type": "integer", "minimum": 1 },
            "rollCount": { "type": "integer", "minimum": 0, "description": "그 줄들이 이미 넘어온 횟수(가장 큰 값)" },
            "failureReason": { "type": "string", "maxLength": 500, "description": "마지막 실패 표시 사유(직원이 적은 글 — 직원 알림용)" },
            "escalatedAt": { "$ref": "_defs.v1.json#/$defs/DateTime" }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
