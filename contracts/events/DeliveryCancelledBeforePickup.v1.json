{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/DeliveryCancelledBeforePickup.v1.json",
  "title": "DeliveryCancelledBeforePickup",
  "description": "픽업 전 취소(상품은 점포 보관). 발행 delivery-dispatch. 구독 delivery-execution, mfc-fulfillment, order. 토픽 delivery.delivery.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "DeliveryCancelledBeforePickup"
        },
        "aggregateType": {
          "const": "Delivery"
        },
        "payload": {
          "type": "object",
          "required": [
            "deliveryId",
            "reason"
          ],
          "properties": {
            "deliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "riderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "assignmentVersion": {
              "$ref": "_defs.v1.json#/$defs/Version"
            },
            "reason": {
              "type": "string",
              "description": "취소 사유 코드. RECOVERY_ABANDONED(2026-11-24) = 오배송 회수 배송이 만들어진 지 24시간 지나도 라이더가 없어 포기"
            },
            "purpose": {
              "type": "string",
              "maxLength": 32,
              "description": "배송 목적(있을 때만 — DeliveryCreated.purpose 와 같음, 2026-11-24)"
            },
            "caseId": {
              "type": "string",
              "maxLength": 64,
              "description": "사건 ID(오배송 회수·재발송 등, 있을 때만 — 2026-11-24)"
            },
            "cancelledAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
