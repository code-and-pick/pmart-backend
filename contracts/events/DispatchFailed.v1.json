{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/DispatchFailed.v1.json",
  "title": "DispatchFailed",
  "description": "배차 불가. 발행 delivery-dispatch. 구독 case, notification, order. 토픽 delivery.delivery.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "DispatchFailed"
        },
        "aggregateType": {
          "const": "Delivery"
        },
        "payload": {
          "type": "object",
          "required": [
            "deliveryId",
            "reason",
            "attempts"
          ],
          "properties": {
            "deliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "reason": {
              "type": "string",
              "enum": [
                "NO_RIDER",
                "REPEATED_REJECTION",
                "EXPIRED",
                "SYSTEM_FAILURE"
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "failedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId",
              "description": "배송의 센터(2026-11-16 DD-MFC — case 사건함이 센터 관리자에게 보일 센터를 정한다). 선택 — 예전 사건에는 없다"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
