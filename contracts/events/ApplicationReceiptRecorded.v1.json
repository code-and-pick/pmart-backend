{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ApplicationReceiptRecorded.v1.json",
  "title": "ApplicationReceiptRecorded",
  "description": "승인 반영 결과 회신(ApplicationReceipt, ADR-0039). 정본 서비스가 ApprovalDecided(APPROVED·PARTIALLY_APPROVED)를 반영한 같은 트랜잭션에서 발행한다. 발행 pricing(1차; 이후 product, product-content, center-master, delivery-serviceability, mfc-inbound, search(SEARCH_SYNONYM — DB 가 없어 outbox 대신 반영 기록 뒤 Kafka 로 바로), ai-assistant·customer-assistant(RAG_DOCUMENT, ADR-0092·0094 — rag-pgvector 에 Debezium 연결을 두지 않아 반영 기록 뒤 Kafka 로 바로) 등 승인 대상 정본). 구독 approval. 토픽 platform.approval-receipt.v1(승인 토픽 platform.approval.v1 과 분리 — 그 구독자에게 가지 않게). 같은 approvalId·receiverService·receiptSeq 재전송은 approval 이 한 번만 반영한다. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ApplicationReceiptRecorded"
        },
        "aggregateType": {
          "const": "ApplicationReceipt"
        },
        "payload": {
          "type": "object",
          "required": [
            "approvalId",
            "receiverService",
            "receiptSeq",
            "result"
          ],
          "properties": {
            "approvalId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "receiverService": {
              "type": "string",
              "description": "반영한 정본 서비스 이름(예: pricing-service)"
            },
            "receiptSeq": {
              "type": "integer",
              "minimum": 1,
              "description": "수신자별 회신 순번(멱등 키의 일부). 한 번에 끝나는 반영은 1"
            },
            "result": {
              "type": "string",
              "enum": [
                "ACCEPTED",
                "APPLIED",
                "PARTIAL",
                "REJECTED",
                "UNKNOWN_RESULT"
              ],
              "description": "승인 전체의 반영 결과. PARTIAL = 일부 행만 반영"
            },
            "domainRef": {
              "type": [
                "string",
                "null"
              ],
              "description": "정본 측 결과 ID(commitId / versionId / grantId)"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "전체 결과 사유(행 사유는 lines[].reasonCode)"
            },
            "lines": {
              "type": "array",
              "description": "행별 결과. 승인 행(lineKey)마다 하나",
              "items": {
                "type": "object",
                "required": [
                  "lineKey",
                  "result"
                ],
                "properties": {
                  "lineKey": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "APPLIED",
                      "REJECTED"
                    ]
                  },
                  "reasonCode": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "거절 사유 코드(정본 서비스 정의, 예: PRICE_SCHEDULE_CONFLICT)"
                  },
                  "domainRef": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "domainVersion": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
