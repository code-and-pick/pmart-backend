{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/WorkRejected.v1.json",
  "title": "WorkRejected",
  "description": "ConfirmOrder 작업을 거절한 사실. 발행 mfc-fulfillment. 구독 order-orchestration(6a 는 동기 응답으로 진행 — 사건은 기록·BI용). 토픽 mfc.fulfillment.v1 2026-11-16: 오배송 재발송(작업 지시 kind RESHIPMENT)이면 purpose MISDELIVERY_RESHIPMENT·caseId.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "WorkRejected"
        },
        "aggregateType": {
          "const": "Fulfillment"
        },
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "rejectReason"
          ],
          "properties": {
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "fulfillmentId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "rejectReason": {
              "type": "string",
              "description": "INVENTORY_MISMATCH / OPERATION_RESTRICTED / CAPACITY_EXCEEDED / LOT_INELIGIBLE / ALREADY_STOPPED (contracts/openapi/mfc-fulfillment-service.yaml WorkRejectReason)"
            },
            "rejectedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "workVersion": {
              "type": "integer",
              "minimum": 1,
              "description": "거절된 작업 버전(2026-11-07 추가)"
            },
            "sagaId": {
              "$ref": "_defs.v1.json#/$defs/Ref",
              "description": "요청한 orchestration 사가(2026-11-07 추가)"
            },
            "retryable": {
              "type": "boolean",
              "description": "같은 MFC 재시도 대상인지(D6-5, 2026-11-07 추가)"
            },
            "message": {
              "type": "string"
            },
            "purpose": {
              "type": "string",
              "enum": [
                "MISDELIVERY_RESHIPMENT"
              ],
              "description": "2026-11-16 — 오배송 재발송 작업 지시의 출고면 MISDELIVERY_RESHIPMENT(없으면 일반 주문 출고)"
            },
            "caseId": {
              "$ref": "_defs.v1.json#/$defs/Ref",
              "description": "오배송 재발송의 근거 사건(case)"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
