{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/AllocationShortfall.v1.json",
  "title": "AllocationShortfall",
  "description": "실사 조정으로 칸 현물이 이관 예약보다 적어져 그 칸에 늦게 잡힌 할당부터 예약을 푼 사실(할당마다). 발행 cdc-inventory(0.10.0 — 설계 docs/cdc/design/2026-11-25-count-adjustment.md §4, 사용자 결정). 구독 cdc-outbound(그 TRF 작업 줄 부족 → 다른 LOT 재할당·못 찾음). 토픽 cdc.inventory.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "AllocationShortfall"
        },
        "aggregateType": {
          "const": "Allocation"
        },
        "payload": {
          "type": "object",
          "required": [
            "cdcId",
            "trfId",
            "allocationId",
            "sku",
            "lot",
            "locationCode",
            "qty",
            "reason"
          ],
          "properties": {
            "cdcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "trfId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "allocationId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "sku": {
              "$ref": "_defs.v1.json#/$defs/Sku"
            },
            "lot": {
              "type": "string"
            },
            "locationCode": {
              "type": "string"
            },
            "qty": {
              "$ref": "_defs.v1.json#/$defs/PositiveQty"
            },
            "reason": {
              "type": "string",
              "enum": [
                "COUNT_LOSS"
              ]
            },
            "sourceRef": {
              "type": "string",
              "description": "실사 세션 ID"
            },
            "occurredAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
